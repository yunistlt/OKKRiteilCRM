NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Keys
RETAILCRM_API_KEY=your-retailcrm-key
RETAILCRM_URL=https://your-domain.retailcrm.ru
TELPHIN_APP_KEY=your-telphin-app-key
TELPHIN_APP_SECRET=your-telphin-app-secret

# AI-секретарь Телфина (узел «Интерактивная обработка» → /api/telphin/secretary)
TELPHIN_SECRETARY_TOKEN=secret-token-in-url       # проверяется как ?token=...
TELPHIN_FALLBACK_EXTENSION=                        # добавочный/группа оператора, если менеджер не найден
TELPHIN_TRANSFER_VAR=transferDestination          # имя переменной схемы для перевода
TELPHIN_TTS_VOICE=alena                            # голос синтеза
TELPHIN_TTS_LANG=ru-RU
TELPHIN_TTS_SPEED=1.0

# ── Платежи «с точки» (банк Точка → распределение по заказам) ─────────────────
# Токен доступа к Точка.API (JWT-ключ из личного кабинета Точки). НЕ коммитить.
TOCHKA_JWT_TOKEN=
# Проверка подписи вебхука Точки. Задайте одно из двух — тогда авто-проброс в RetailCRM
# включается только для подписанных платежей (иначе они уходят в ручной разбор).
TOCHKA_WEBHOOK_JWKS_URL=                            # URL JWKS с публичным ключом Точки
TOCHKA_WEBHOOK_PUBLIC_KEY=                          # либо публичный ключ в формате PEM (SPKI)
# Опциональный общий секрет вебхука (проверяется в ?secret= или заголовке x-webhook-secret).
TOCHKA_WEBHOOK_SECRET=
# Код типа оплаты в RetailCRM (справочник payment-types), которым создаётся платёж на заказе.
RETAILCRM_BANK_PAYMENT_TYPE=bank-transfer
